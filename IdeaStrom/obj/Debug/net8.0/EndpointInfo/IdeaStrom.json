{
  "openapi": "3.0.4",
  "info": {
    "title": "IdeaStrom API",
    "version": "v1"
  },
  "paths": {
    "/api/Ideas/submit": {
      "post": {
        "tags": [
          "Ideas"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IdeaRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/IdeaRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/IdeaRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Ideas/comment": {
      "post": {
        "tags": [
          "Ideas"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CommentSubmission"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CommentSubmission"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CommentSubmission"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Ideas/notifications/{userId}": {
      "get": {
        "tags": [
          "Ideas"
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Ideas/vote": {
      "post": {
        "tags": [
          "Ideas"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VoteSubmission"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/VoteSubmission"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/VoteSubmission"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Ideas/review": {
      "post": {
        "tags": [
          "Ideas"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewSubmission"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewSubmission"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewSubmission"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Ideas/top": {
      "get": {
        "tags": [
          "Ideas"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Ideas/register": {
      "post": {
        "tags": [
          "Ideas"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserRegistration"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UserRegistration"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UserRegistration"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
